rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /signups/{doc} {
      allow read, write: if true;
    }
    match /pollVotes/{doc} {
      allow read, write: if true;
    }
    match /tasks/{doc} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
